{
  "name": "@homepi/app-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "HomePi backend API gateway",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/assets && cp -r src/assets/. dist/assets/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js"
  },
  "dependencies": {
    "@homepi/core-api": "workspace:*",
    "@homepi/core-config": "workspace:*",
    "@homepi/core-events": "workspace:*",
    "@homepi/core-health": "workspace:*",
    "@homepi/core-logging": "workspace:*",
    "@homepi/core-messaging": "workspace:*",
    "@homepi/core-service-registry": "workspace:*",
    "@homepi/core-state": "workspace:*",
    "@homepi/core-transport": "workspace:*",
    "mqtt": "^5.13.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@homepi/tooling-schema-validation": "workspace:*",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^22.15.21",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
