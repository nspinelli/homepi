{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/auth/principal.schema.json",
  "title": "HomePi Principal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "displayName"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "user",
        "service",
        "system"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
