{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/auth/session.schema.json",
  "title": "HomePi Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId",
    "principalId",
    "createdAt",
    "expiresAt"
  ],
  "properties": {
    "sessionId": {
      "type": "string"
    },
    "principalId": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
