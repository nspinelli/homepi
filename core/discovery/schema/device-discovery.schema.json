{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/discovery/device-discovery.schema.json",
  "title": "HomePi Discoverable Device",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "discoveredAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "discoveredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
