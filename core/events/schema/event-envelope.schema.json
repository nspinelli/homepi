{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/events/event-envelope.schema.json",
  "title": "HomePi Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "source",
    "topic",
    "event",
    "correlationId",
    "timestamp",
    "payload"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "pattern": "^homepi-[a-z0-9-]+$"
    },
    "topic": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*)*$"
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
