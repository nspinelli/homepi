{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/events/replay-request.schema.json",
  "title": "HomePi Event Replay Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topics",
    "requestedAt"
  ],
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 500
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
