{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/events/snapshot.schema.json",
  "title": "HomePi Event Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "topic",
    "timestamp",
    "state"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": "string",
      "pattern": "^homepi-[a-z0-9-]+$"
    },
    "topic": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
