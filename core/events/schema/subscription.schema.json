{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/events/subscription.schema.json",
  "title": "HomePi Event Subscription",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "topics",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "string",
      "pattern": "^homepi-[a-z0-9-]+$"
    },
    "replay": {
      "type": "boolean",
      "default": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
