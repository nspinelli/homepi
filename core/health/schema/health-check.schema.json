{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/health/health-check.schema.json",
  "title": "HomePi Health Check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "status"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "message": {
      "type": "string"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "object"
    }
  }
}
