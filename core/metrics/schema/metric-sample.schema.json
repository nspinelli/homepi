{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/metrics/metric-sample.schema.json",
  "title": "HomePi Metric Sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "type",
    "value",
    "timestamp"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "type": {
      "type": "string",
      "enum": [
        "counter",
        "gauge",
        "timer"
      ]
    },
    "value": {
      "type": "number"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
