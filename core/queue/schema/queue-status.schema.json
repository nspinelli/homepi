{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/queue/queue-status.schema.json",
  "title": "HomePi Queue Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "depth",
    "capacity",
    "state"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "capacity": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "paused",
        "draining",
        "failed"
      ]
    }
  }
}
