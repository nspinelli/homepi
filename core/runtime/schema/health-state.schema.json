{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/runtime/health-state.schema.json",
  "title": "HomePi Runtime Health State",
  "description": "Runtime health state payload emitted by HomePi services and health checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "status",
    "checkedAt",
    "uptimeMs",
    "checks"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^homepi-[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "starting",
        "healthy",
        "degraded",
        "stopping",
        "failed"
      ]
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0
    },
    "watchdogHealthy": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "message": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
