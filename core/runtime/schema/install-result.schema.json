{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/runtime/install-result.schema.json",
  "title": "HomePi Runtime Install Result",
  "description": "Structured result emitted after a HomePi install or uninstall action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "action",
    "status",
    "startedAt",
    "finishedAt",
    "steps"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^homepi-[a-z0-9-]+$"
    },
    "action": {
      "type": "string",
      "enum": [
        "install",
        "uninstall",
        "upgrade",
        "repair"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "partial"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed",
              "skipped"
            ]
          },
          "message": {
            "type": "string"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
