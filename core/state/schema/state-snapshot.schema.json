{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/state/state-snapshot.schema.json",
  "title": "HomePi State Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "owner",
    "topic",
    "createdAt",
    "state"
  ],
  "properties": {
    "snapshotId": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "pattern": "^homepi-[a-z0-9-]+$"
    },
    "topic": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
