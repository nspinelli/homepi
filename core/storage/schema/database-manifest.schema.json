{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/core/storage/database-manifest.schema.json",
  "title": "HomePi Database Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "engine",
    "path",
    "owner"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "sqlite"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "owner": {
      "type": "string"
    }
  }
}
