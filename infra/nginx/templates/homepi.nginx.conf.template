# HomePi NGINX site template
# Substitute: HOMEPI_WEB_ROOT, HOMEPI_BACKEND_UPSTREAM, HOMEPI_SERVER_NAME

upstream homepi_backend {
    server ${HOMEPI_BACKEND_UPSTREAM};
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${HOMEPI_SERVER_NAME};

    # Redirect to HTTPS when TLS is configured
    # return 301 https://$host$request_uri;

    root ${HOMEPI_WEB_ROOT};
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://homepi_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    location /events {
        proxy_pass http://homepi_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
    }

    location /ws {
        proxy_pass http://homepi_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 86400;
    }

    # Legacy aliases for clients expecting /api/events and /api/ws
    location /api/events {
        proxy_pass http://homepi_backend/events;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
    }

    location /api/ws {
        proxy_pass http://homepi_backend/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 86400;
    }
}
