{
  "service": "homepi-audio-orchestrator",
  "version": "0.1.0",
  "logging": {
    "level": "INFO"
  },
  "runtime": {
    "paths": {
      "socketDir": "/run/homepi",
      "databasePath": "/opt/homepi/runtime/state/homepi.sqlite"
    }
  },
  "sockets": {
    "eventsSocket": "/run/homepi/broker/broker.sock",
    "pcmRouterSocket": "/run/homepi/audio/pcm-router.sock",
    "hifiSerialSocket": "/run/homepi/audio/hifi-serial.sock"
  },
  "defaults": {
    "airplaySource": 5
  },
  "nqptp": {
    "host": "127.0.0.1",
    "port": 9000
  }
}
