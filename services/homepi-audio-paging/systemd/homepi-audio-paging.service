[Unit]
Description=HomePi Audio Paging Service
After=homepi-broker.service homepi-usb-devices.service homepi-hifi-serial.service
Wants=homepi-broker.service homepi-usb-devices.service homepi-hifi-serial.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=homepi
Group=homepi
SupplementaryGroups=audio
WorkingDirectory=/opt/homepi/services/audio-paging
ExecStartPre=-/bin/bash /opt/homepi/services/audio-paging/scripts/sync-alsa-user-config.sh
ExecStart=/opt/homepi/services/audio-paging/bin/homepi-audio-paging /opt/homepi/services/audio-paging/config/service-config.json
Restart=on-failure
RestartSec=10
StartLimitAction=none
EnvironmentFile=-/opt/homepi/services/audio-paging/env/.env
Environment=LD_LIBRARY_PATH=/opt/homepi/services/audio-paging/bin/piper-runtime
RuntimeDirectory=homepi/audio
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
