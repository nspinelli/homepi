{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homepi.local/schema/services/hifi-serial/hifi-socket-request.schema.json",
  "title": "HiFi Serial Socket Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["method", "correlationId"],
  "properties": {
    "method": {
      "type": "string",
      "enum": [
        "getHealth",
        "syncController",
        "sendCommand",
        "getSnapshot",
        "getController",
        "getZones",
        "getSources",
        "getGroups",
        "getLanguageStrings",
        "getAirplaySource",
        "setAirplaySource",
        "subscribe"
      ]
    },
    "correlationId": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 }
  }
}
