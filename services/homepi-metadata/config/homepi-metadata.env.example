HOMEPI_EVENT_SOCKET=/run/homepi/metadata.sock
HOMEPI_PCM_ROUTER_SOCKET=/run/homepi/pcm-router.sock
HOMEPI_DATABASE_PATH=/opt/homepi/runtime/state/metadata.db
HOMEPI_CACHE_DIR=/opt/homepi/runtime/cache
HOMEPI_METADATA_PIPE_PREFIX=/tmp/homepi-metadata-zone-
HOMEPI_ZONE_COUNT=16
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=shairport/zone
LOG_LEVEL=INFO
METADATA_DEBOUNCE_MS=250
