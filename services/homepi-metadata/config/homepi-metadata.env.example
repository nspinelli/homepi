HOMEPI_EVENT_SOCKET=/run/homepi/audio/metadata.sock
HOMEPI_EVENTS_SOCKET=/run/homepi/broker/broker.sock
HOMEPI_AUDIO_REALTIME_SOCKET=/run/homepi/audio/audio-realtime.sock
HOMEPI_PCM_ROUTER_SOCKET=/run/homepi/audio/pcm-router.sock
HOMEPI_DATABASE_PATH=/opt/homepi/runtime/state/homepi.sqlite
HOMEPI_CACHE_DIR=/opt/homepi/runtime/cache
HOMEPI_METADATA_PIPE_PREFIX=/tmp/homepi-metadata-zone-
HOMEPI_ZONE_COUNT=16
LOG_LEVEL=INFO
METADATA_DEBOUNCE_MS=250
