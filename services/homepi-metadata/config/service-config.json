{
  "service": "homepi-metadata",
  "version": "2.0.0",
  "environment": "production",
  "enabled": true,
  "logging": {
    "level": "INFO",
    "debugTrace": false
  },
  "runtime": {
    "paths": {
      "homepiRoot": "/opt/homepi",
      "runtimeDir": "/opt/homepi/runtime",
      "generatedDir": "/opt/homepi/runtime/generated",
      "cacheDir": "/opt/homepi/runtime/cache",
      "stateDir": "/opt/homepi/runtime/state",
      "socketDir": "/run/homepi"
    }
  },
  "metadata": {
    "pipePrefix": "/tmp/homepi-metadata-zone-",
    "zoneCount": 16,
    "pcmRouterSocket": "/run/homepi/audio/pcm-router.sock",
    "databasePath": "/opt/homepi/runtime/state/metadata.db"
  }
}
