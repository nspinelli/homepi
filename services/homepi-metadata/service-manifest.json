{
  "service": "homepi-metadata",
  "displayName": "HomePi Metadata",
  "description": "Efficient PCM-owner metadata daemon for Shairport Sync FIFO pipes.",
  "version": "2.0.0",
  "type": "cpp",
  "enabled": true,
  "dependencies": [
    "homepi-pcm-router",
    "homepi-shairport-supervisor"
  ],
  "runtime": {
    "execStart": "/opt/homepi/services/metadata/bin/homepi-metadata",
    "workingDirectory": "/opt/homepi/services/metadata",
    "user": "homepi",
    "group": "homepi",
    "socketPaths": [
      "/run/homepi/metadata.sock"
    ]
  },
  "systemd": {
    "unitName": "homepi-metadata.service",
    "after": [
      "homepi-pcm-router.service"
    ],
    "wants": [
      "homepi-pcm-router.service"
    ]
  }
}
