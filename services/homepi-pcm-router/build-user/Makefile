# target to preprocess a source file
tests/test-routing-state.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_routing_state.dir/build.make CMakeFiles/test_routing_state.dir/tests/test-routing-state.cpp.i
.PHONY : tests/test-routing-state.cpp.i

tests/test-routing-state.s: tests/test-routing-state.cpp.s
.PHONY : tests/test-routing-state.s

# target to generate assembly for a file
tests/test-routing-state.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_routing_state.dir/build.make CMakeFiles/test_routing_state.dir/tests/test-routing-state.cpp.s
.PHONY : tests/test-routing-state.cpp.s

