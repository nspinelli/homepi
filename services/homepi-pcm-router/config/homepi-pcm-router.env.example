HOMEPI_ZONE_COUNT=16

HOMEPI_DATABASE_PATH=/opt/homepi/runtime/state/homepi.sqlite
HOMEPI_GENERATED_DIR=/opt/homepi/runtime/generated
HOMEPI_EVENT_SOCKET=/run/homepi/pcm-router.sock
HOMEPI_USB_DEVICES_SOCKET=/run/homepi/usb-devices.sock
HOMEPI_EVENTS_SOCKET=/run/homepi/events.sock

ALSA_LOOPBACK_CARDS=HomePiZonesA,HomePiZonesB

PERIOD_FRAMES=512
BUFFER_FRAMES=4096
CAPTURE_IDLE_CLOSE_DELAY_MS=5000

LOG_LEVEL=info
