HOMEPI_ZONE_COUNT=16

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_FILTER=shairport/zone/+/+

HOMEPI_DATABASE_PATH=/opt/homepi/runtime/state/homepi.sqlite
HOMEPI_EVENT_SOCKET=/run/homepi/pcm-router.sock
HOMEPI_PRIMARY_ALSA_CARD=HomePiPrimaryAudio

ALSA_LOOPBACK_CARDS=HomePiZonesA,HomePiZonesB

HOMEPI_AUDIO_RATE=48000
HOMEPI_AUDIO_CHANNELS=2
HOMEPI_AUDIO_FORMAT=S32_LE

PERIOD_FRAMES=256
BUFFER_FRAMES=1024

FADE_MS=10
METADATA_DEBOUNCE_MS=250
DAC_IDLE_KEEPALIVE_MS=300000

LOG_LEVEL=info
