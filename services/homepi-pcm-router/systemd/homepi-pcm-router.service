[Unit]
Description=HomePi PCM Router
After=network-online.target sound.target homepi-usb-devices.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=homepi
Group=audio
SupplementaryGroups=audio
EnvironmentFile=/opt/homepi/services/pcm-router/env/.env
ExecStart=/opt/homepi/services/pcm-router/bin/homepi-pcm-router
Restart=on-failure
RestartSec=10
StartLimitAction=none
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
