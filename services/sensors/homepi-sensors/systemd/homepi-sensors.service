[Unit]
Description=HomePi Contact Sensors Module Facade
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homepi
Group=homepi
RuntimeDirectory=homepi/sensors
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/node /opt/homepi/services/sensors/homepi-sensors/dist/main.js
Restart=on-failure
RestartSec=2
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
